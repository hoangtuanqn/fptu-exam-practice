  "private": true,
  "description": "API cho web luyện đề: đăng nhập, phân quyền, ví và nạp tiền SePay",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "tsx src/seeders/admin.seeder.ts",
    "import:fuo-catalog": "tsx scripts/import-fuo-catalog.ts",
    "import:subject-semesters": "tsx scripts/import-subject-semesters.ts",
    "import:syllabus": "tsx scripts/import-syllabus.ts",
    "relabel:topics": "tsx scripts/relabel-topics.ts",
    "import:syllabus-details": "tsx scripts/import-syllabus-details.ts",
    "search:syllabus": "tsx scripts/search-syllabus.ts",
    "reindex:knowledge": "tsx scripts/reindex-knowledge.ts",
    "eval:rag": "tsx scripts/eval-rag.ts",
    "export:subjects": "tsx scripts/export-subjects-seo.ts",
    "label:topics": "tsx scripts/label-topics.ts",
    "audit:exams": "tsx scripts/audit-exams.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
