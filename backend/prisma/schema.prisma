generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  fullName  String     @map("full_name")
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  balance   Int        @default(0)
  referralCode String?   @unique @map("referral_code") @db.VarChar(12) // mĂ£ giá»›i thiá»‡u cá»§a chĂ­nh ngÆ°á»i nĂ y
  referredById Int?      @map("referred_by_id") // ngÆ°á»i Ä‘Ă£ giá»›i thiá»‡u
  googleSub    String?   @unique @map("google_sub") @db.VarChar(64) // tĂ i khoáº£n Google Ä‘Ă£ liĂªn káº¿t
  githubId     String?   @unique @map("github_id") @db.VarChar(32) // tai khoan GitHub da lien ket (id so)
  avatarPath   String?   @map("avatar_path") @db.VarChar(120) // null = dung mascot mac dinh
  proExpiresAt DateTime? @map("pro_expires_at") // het han goi Pro; null hoac da qua = khong phai Pro
  reminderEnabled Boolean   @default(false) @map("reminder_enabled") // nhac on qua email (mac dinh tat, nguoi dung tu bat)
  examDate        DateTime? @map("exam_date") @db.Date // ngay thi nguoi dung dat de thu nhac co dem nguoc
  reminderSentOn  DateTime? @map("reminder_sent_on") @db.Date // ngay gan nhat da gui thu nhac (toi da 1 thu moi ngay)
  studyGoalDays Int @default(3) @map("study_goal_days") // muc tieu so ngay hoc moi tuan (3, 5 hoac 7)
  emailVerifiedAt DateTime? @map("email_verified_at") // chÆ°a xĂ¡c minh email thĂ¬ chÆ°a dĂ¹ng Ä‘Æ°á»£c cĂ¡c dá»‹ch vá»¥ trá»« credit
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  walletTransactions WalletTransaction[]
  depositOrders      DepositOrder[]
  userExams          UserExam[]
  attempts           ExamAttempt[]
  passwordResets     PasswordResetToken[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerificationToken[]
  giftRedemptions    GiftCodeRedemption[]
  creditLots         CreditLot[]
  answerReports      AnswerReport[]
  explanationBuys    ExplanationPurchase[]
  explanationUnlocks ExplanationUnlock[]
  peDownloads        PeDownload[]
  dailyCheckIns      DailyCheckIn[]
  planPurchases      PlanPurchase[]
  promptEvents       PromptEvent[]
  proTickets         ProTicket[]
  reviewItems        ReviewItem[]
  studyDays          StudyDay[]
  gradeSetting       UserGradeSetting?
  grades             UserGrade[]
  examSlots          UserExamSlot[]
  linkRewardRequests LinkRewardRequest[]
  freeExplainTurns   FreeExplainTurn[]
  referredBy         User?                @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]               @relation("Referral")
  rewardsAsReferrer  ReferralReward[]     @relation("RewardReferrer")
  rewardsAsReferred  ReferralReward[]     @relation("RewardReferred")

  @@index([referredById])
  @@index([status]) // dashboard Ä‘áº¿m theo tráº¡ng thĂ¡i
  @@index([role, status]) // danh sĂ¡ch thĂ nh viĂªn lá»c vai trĂ²/tráº¡ng thĂ¡i
  @@map("users")
  practiceSessions PracticeSession[]
}

enum DepositStatus {
  PENDING
  PAID
  EXPIRED
}

// Lá»‡nh náº¡p tiá»n: ngÆ°á»i dĂ¹ng chuyá»ƒn khoáº£n kĂ¨m `code` trong ná»™i dung Ä‘á»ƒ há»‡ thá»‘ng Ä‘á»‘i soĂ¡t
model DepositOrder {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  code      String        @unique @db.VarChar(30)
  amount    Int
  status    DepositStatus @default(PENDING)
  expiresAt DateTime      @map("expires_at")
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id])
  bankTransaction BankTransaction?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("deposit_orders")
}

enum BankTxStatus {
  MATCHED // khá»›p lá»‡nh náº¡p vĂ  Ä‘Ă£ cá»™ng tiá»n
  UNMATCHED // tiá»n vĂ o nhÆ°ng khĂ´ng khá»›p lá»‡nh nĂ o (admin xá»­ lĂ½ tay)
}

// Giao dá»‹ch ngĂ¢n hĂ ng láº¥y tá»« SePay. `sepayId` unique Ä‘á»ƒ cĂ¹ng má»™t giao dá»‹ch khĂ´ng bao giá» cá»™ng tiá»n hai láº§n
model BankTransaction {
  id             Int          @id @default(autoincrement())
  sepayId        String       @unique @map("sepay_id") @db.VarChar(40)
  gateway        String?
  accountNumber  String?      @map("account_number")
  content        String       @db.Text
  amountIn       Int          @map("amount_in")
  referenceCode  String?      @map("reference_code")
  transactionAt  DateTime     @map("transaction_at")
  status         BankTxStatus
  depositOrderId Int?         @unique @map("deposit_order_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  depositOrder DepositOrder? @relation(fields: [depositOrderId], references: [id])

  // Dashboard cá»™ng tiá»n theo status + transactionAt: index "phá»§" luĂ´n amountIn nĂªn khĂ´ng cáº§n Ä‘á»c tá»«ng dĂ²ng.
  // Tiá»n tá»‘ (status) cÅ©ng phá»¥c vá»¥ danh sĂ¡ch lá»c theo tráº¡ng thĂ¡i nĂªn thay cho (status, createdAt) cÅ©
  @@index([status, transactionAt, amountIn])
  @@map("bank_transactions")
}

// Cáº¥u hĂ¬nh dáº¡ng key-value, admin sá»­a Ä‘Æ°á»£c trĂªn panel (SePay, cron, ...)
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum TransactionType {
  DEPOSIT
  ADMIN_ADJUST
  CRAWL_CHARGE // trá»« phĂ­ láº¥y Ä‘á» tá»« FuOverflow
  CRAWL_REFUND // hoĂ n phĂ­ khi láº¥y Ä‘á» tháº¥t báº¡i
  GIFT_CODE // nháº­n credit tá»« giftcode
  REPORT_REWARD // thÆ°á»Ÿng khi bĂ¡o cĂ¡o Ä‘Ă¡p Ă¡n sai Ä‘Æ°á»£c xĂ¡c nháº­n
  EXPLAIN_CHARGE // phĂ­ xem lá»i giáº£i thĂ­ch AI cá»§a má»™t cĂ¢u
  EXPLAIN_REFUND // hoĂ n phĂ­ khi AI khĂ´ng giáº£i thĂ­ch Ä‘Æ°á»£c
  REFERRAL_BONUS // thÆ°á»Ÿng giá»›i thiá»‡u (Ä‘Äƒng kĂ½ qua mĂ£ giá»›i thiá»‡u)
  REFERRAL_COMMISSION // hoa há»“ng khi ngÆ°á»i Ä‘Æ°á»£c giá»›i thiá»‡u náº¡p tiá»n
  SIGNUP_BONUS // credit táº·ng má»i tĂ i khoáº£n má»›i khi Ä‘Äƒng kĂ½ (admin cáº¥u hĂ¬nh)
  DEPOSIT_BONUS // thÆ°á»Ÿng thĂªm khi náº¡p tá»« má»™t má»©c nháº¥t Ä‘á»‹nh
  PE_CHARGE // phĂ­ táº£i bá»™ tĂ i nguyĂªn Ä‘á» thi PE (file zip)
  PE_REFUND // hoĂ n phĂ­ khi khĂ´ng táº¡o Ä‘Æ°á»£c file zip
  PLAN_CHARGE // mua gói Pro
  CHECKIN_REWARD // thưởng điểm danh hằng ngày (kể cả thưởng đủ 7 ngày)
  CREDIT_EXPIRED // credit nhan tu giftcode co han da het han ma chua dung
}

// Sá»• cĂ¡i vĂ­: má»—i láº§n sá»‘ dÆ° Ä‘á»•i lĂ  má»™t dĂ²ng (amount Ă¢m = trá»« tiá»n)
model WalletTransaction {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  note         String?
  createdAt    DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt]) // admin lá»c biáº¿n Ä‘á»™ng sá»‘ dÆ° theo loáº¡i
  @@map("wallet_transactions")
}

// Điểm danh hằng ngày: mỗi người một dòng mỗi ngày (theo giờ Việt Nam). `day` là ngày dạng DATE; `streak` là số ngày liên tiếp tính đến ngày đó
model DailyCheckIn {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  day       DateTime @db.Date
  streak    Int
  amount    Int // credit đã nhận (gồm thưởng đủ 7 ngày)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("daily_check_ins")
}

// Äá» thi láº¥y tá»« FuOverflow. `threadId` lĂ  chá»¯ kĂ½ cá»§a Ä‘á»: nháº­p láº¡i cĂ¹ng thread (dĂ¹ link khĂ¡c) khĂ´ng táº¡o báº£n má»›i
model Exam {
  id             Int       @id @default(autoincrement())
  threadId       String    @unique @map("thread_id") @db.VarChar(20)
  title          String    @db.VarChar(255)
  sourceUrl      String    @map("source_url") @db.VarChar(500)
  author         String?   @db.VarChar(100)
  postedAt       DateTime? @map("posted_at")
  totalQuestions Int       @map("total_questions")
  // Nguá»“n Ä‘Ă¡p Ă¡n: DEFAULT (táº¡m lĂ  A), AI (Claude giáº£i), MANUAL (chá»‰nh tay). aiReport lĂ  bĂ¡o cĂ¡o cá»§a AI (cĂ¢u nghi ngá»...)
  answerSource   String    @default("DEFAULT") @map("answer_source") @db.VarChar(10)
  aiReport       String?   @map("ai_report") @db.Text
  createdById    Int?      @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  subjectCode    String?   @map("subject_code") @db.VarChar(20) // subject code taken from the title (PRO192...); null = no code found. Set on import/rename, filled at boot for old rows
  refreshedAt    DateTime? @map("refreshed_at") // láº§n lĂ m má»›i gáº§n nháº¥t (láº¥y láº¡i áº£nh, bĂ¬nh luáº­n, giáº£i láº¡i Ä‘Ă¡p Ă¡n); null = chÆ°a tá»«ng

  questions ExamQuestion[]
  crawlJobs CrawlJob[]
  userExams UserExam[]
  attempts  ExamAttempt[]
  reports   AnswerReport[]
  explanations QuestionExplanation[]
  explanationBuys ExplanationPurchase[]
  reviewItems ReviewItem[]
  explanationUnlocks ExplanationUnlock[]

  @@index([subjectCode, answerSource])
  @@map("exams")
  practiceSessions PracticeSession[]
}

// Má»—i áº£nh lĂ  má»™t cĂ¢u há»i. `answer` táº¡m lĂ  "A" cho Ä‘áº¿n khi cĂ³ logic xĂ¡c Ä‘á»‹nh Ä‘Ă¡p Ă¡n Ä‘Ăºng
model ExamQuestion {
  id          Int     @id @default(autoincrement())
  examId      Int     @map("exam_id")
  number      Int
  name        String  @db.VarChar(100)
  imagePath   String  @map("image_path") @db.VarChar(255)
  sourceImage String  @map("source_image") @db.VarChar(500)
  mediaUrl    String? @map("media_url") @db.VarChar(500)
  answer      String  @default("A") @db.VarChar(20)
  // áº¢nh tĂ i liá»‡u tham kháº£o (trang cĂ´ng thá»©c...), khĂ´ng pháº£i cĂ¢u há»i: khĂ´ng cháº¥m Ä‘iá»ƒm, giao diá»‡n Ä‘Æ°a vĂ o má»¥c "TĂ i liá»‡u tham kháº£o"
  isReference Boolean @default(false) @map("is_reference")
  topic       String? @db.VarChar(255) // chu de cua cau (lay tu syllabus mon hoc, do AI gan); null = chua gan
  imageHash   Bytes?  @map("image_hash") @db.VarBinary(192) // dau van tay vung chu cua anh (de nhan ra cau lap lai giua cac de); null = chua tinh

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, number])
  @@map("exam_questions")
}

enum CrawlJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Má»™t lÆ°á»£t nháº­p Ä‘á»: táº¡o á»Ÿ tráº¡ng thĂ¡i QUEUED, worker ná»n nháº­n vĂ  cáº­p nháº­t `stage` theo tá»«ng bÆ°á»›c
model CrawlJob {
  id            Int            @id @default(autoincrement())
  threadId      String         @map("thread_id") @db.VarChar(20)
  userId        Int?           @map("user_id") // khĂ¡ch chÆ°a Ä‘Äƒng nháº­p thĂ¬ null, dĂ¹ng guestId
  guestId       String?        @map("guest_id") @db.VarChar(64)
  status        CrawlJobStatus @default(QUEUED)
  stage         String?        @db.VarChar(120)
  error         String?        @db.Text
  examId        Int?           @map("exam_id")
  chargedAmount Int            @default(0) @map("charged_amount") // phĂ­ Ä‘Ă£ trá»«, Ä‘á»ƒ hoĂ n Ä‘Ăºng sá»‘ tiá»n náº¿u job lá»—i
  refresh       Boolean        @default(false) // lÆ°á»£t lĂ m má»›i Ä‘á» cÅ© cĂ³ sáºµn trong há»‡ thá»‘ng (cháº¡y ná»n, khĂ´ng tĂ­nh phĂ­)
  createdAt     DateTime       @default(now()) @map("created_at")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")

  exam Exam? @relation(fields: [examId], references: [id])

  @@index([threadId, status])
  @@index([guestId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt]) // lá»‹ch sá»­ láº¥y Ä‘á» theo thĂ nh viĂªn
  @@map("crawl_jobs")
}

// ThÆ° viá»‡n Ä‘á» cá»§a tá»«ng ngÆ°á»i: nháº­p link xong lĂ  Ä‘á» náº±m trong Ä‘Ă¢y (Ä‘á» dĂ¹ng chung, chá»‰ lÆ°u liĂªn káº¿t)
model UserExam {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  guestId   String?  @map("guest_id") @db.VarChar(64) // khĂ¡ch chÆ°a Ä‘Äƒng nháº­p: kho riĂªng theo trĂ¬nh duyá»‡t, nháº­n vá» tĂ i khoáº£n khi Ä‘Äƒng kĂ½
  examId    Int      @map("exam_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@unique([guestId, examId])
  @@index([guestId, createdAt])
  @@index([userId, createdAt])
  @@map("user_exams")
}

enum AttemptMode {
  PRACTICE
  EXAM
}

// Má»™t láº§n ná»™p bĂ i. `details` lĂ  áº£nh chá»¥p tá»«ng cĂ¢u (Ä‘Ă£ chá»n, Ä‘Ă¡p Ă¡n Ä‘Ăºng lĂºc cháº¥m) nĂªn xem láº¡i váº«n Ä‘Ăºng
// dĂ¹ sau nĂ y Ä‘Ă¡p Ă¡n cá»§a Ä‘á» Ä‘Æ°á»£c sá»­a
model ExamAttempt {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  examId      Int         @map("exam_id")
  mode        AttemptMode
  score       Float
  totalGraded Int         @map("total_graded")
  correct     Int
  wrong       Int
  skipped     Int
  durationSec Int         @map("duration_sec")
  details     Json
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, examId])
  @@map("exam_attempts")
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
}

// Má»™t láº§n báº¥m "lĂ m bĂ i" tá»« kho Ä‘á». ÄĂ¡p Ă¡n, cĂ¢u Ä‘Ă£ chá»‘t, cĂ¢u Ä‘Ă¡nh dáº¥u vĂ  vá»‹ trĂ­ Ä‘Æ°á»£c lÆ°u liĂªn tá»¥c Ä‘á»ƒ táº£i láº¡i trang váº«n lĂ m tiáº¿p Ä‘Æ°á»£c
model PracticeSession {
  id         Int           @id @default(autoincrement())
  userId     Int?          @map("user_id")
  guestId    String?       @map("guest_id") @db.VarChar(64)
  examId     Int           @map("exam_id")
  mode       AttemptMode
  status     SessionStatus @default(IN_PROGRESS)
  answers    Json
  checked    Json
  flagged    Json
  current    Int           @default(0)
  elapsedSec Int           @default(0) @map("elapsed_sec")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([guestId, status, updatedAt])
  @@index([examId])
  @@map("practice_sessions")
}

// Token Ä‘áº·t láº¡i máº­t kháº©u gá»­i qua email. Chá»‰ lÆ°u bÄƒm SHA-256 cá»§a token (lá»™ DB cÅ©ng khĂ´ng dĂ¹ng Ä‘Æ°á»£c), dĂ¹ng má»™t láº§n, cĂ³ háº¡n
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// PhiĂªn Ä‘Äƒng nháº­p dĂ i háº¡n. Chá»‰ lÆ°u bÄƒm SHA-256 cá»§a token (lá»™ DB cÅ©ng khĂ´ng dĂ¹ng Ä‘Æ°á»£c).
// Má»—i láº§n lĂ m má»›i lĂ  xoay vĂ²ng: token cÅ© bá»‹ thu há»“i, token má»›i cĂ¹ng `familyId`. Token Ä‘Ă£ thu há»“i mĂ  bá»‹ dĂ¹ng láº¡i
// (dáº¥u hiá»‡u bá»‹ Ä‘Ă¡nh cáº¯p) thĂ¬ thu há»“i cáº£ há» `familyId`, buá»™c Ä‘Äƒng nháº­p láº¡i.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  familyId   String    @map("family_id") @db.VarChar(36)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Giftcode: admin táº¡o mĂ£, thĂ nh viĂªn nháº­p mĂ£ Ä‘á»ƒ nháº­n credit. Má»—i thĂ nh viĂªn dĂ¹ng má»™t mĂ£ tá»‘i Ä‘a má»™t láº§n.
model GiftCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(32)
  amount    Int // credit cá»™ng cho má»—i lÆ°á»£t dĂ¹ng
  maxUses   Int       @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  active    Boolean   @default(true)
  note      String?   @db.VarChar(200)
  creditTtlMinutes Int? @map("credit_ttl_minutes") // null = credit vinh vien; co so = credit het han sau chung nay phut ke tu luc nhap
  createdAt DateTime  @default(now()) @map("created_at")

  redemptions GiftCodeRedemption[]

  @@index([createdAt])
  @@map("gift_codes")
}

model GiftCodeRedemption {
  id         Int      @id @default(autoincrement())
  giftCodeId Int      @map("gift_code_id")
  userId     Int      @map("user_id")
  amount     Int
  createdAt  DateTime @default(now()) @map("created_at")

  giftCode GiftCode @relation(fields: [giftCodeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giftCodeId, userId])
  @@index([userId])
  @@map("gift_code_redemptions")
}

// A lot of expiring credit (from a giftcode with a time limit). users.balance includes sum(remaining).
// Debits consume lots first (earliest expiry first); unused credit of an expired lot is removed by the expiry job.
model CreditLot {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  source     String   @db.VarChar(20) // GIFT_CODE
  amount     Int // credit granted
  remaining  Int // credit not yet spent or expired
  expiresAt  DateTime @map("expires_at")
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remaining, expiresAt])
  @@index([expiresAt, remaining]) // expiry job scan
  @@map("credit_lots")
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// NgÆ°á»i dĂ¹ng bĂ¡o cĂ¡o Ä‘Ă¡p Ă¡n sai vĂ  Ä‘á» xuáº¥t Ä‘Ă¡p Ă¡n Ä‘Ăºng. Admin duyá»‡t: Ä‘Ăºng thĂ¬ sá»­a Ä‘Ă¡p Ă¡n vĂ  thÆ°á»Ÿng credit cho ngÆ°á»i bĂ¡o cĂ¡o.
// Má»—i ngÆ°á»i chá»‰ bĂ¡o cĂ¡o má»™t láº§n cho má»—i cĂ¢u (chá»‘ng láº¡m dá»¥ng).
model AnswerReport {
  id             Int          @id @default(autoincrement())
  examId         Int          @map("exam_id")
  questionNumber Int          @map("question_number")
  userId         Int          @map("user_id")
  currentAnswer  String       @map("current_answer") @db.VarChar(20) // Ä‘Ă¡p Ă¡n Ä‘ang cĂ³ lĂºc bĂ¡o cĂ¡o
  proposedAnswer String       @map("proposed_answer") @db.VarChar(20)
  reason         String       @db.VarChar(1000)
  status         ReportStatus @default(PENDING)
  reward         Int          @default(0) // credit Ä‘Ă£ thÆ°á»Ÿng (khi Ä‘Æ°á»£c duyá»‡t)
  reviewNote     String?      @map("review_note") @db.VarChar(300)
  reviewedById   Int?         @map("reviewed_by_id")
  reviewedAt     DateTime?    @map("reviewed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@index([status, createdAt])
  @@index([examId])
  @@map("answer_reports")
}

// Lá»i giáº£i thĂ­ch AI cá»§a má»™t cĂ¢u, lÆ°u láº¡i dĂ¹ng chung: ngÆ°á»i sau mua váº«n tráº£ phĂ­ nhÆ°ng khĂ´ng tá»‘n thĂªm lÆ°á»£t gá»i AI
model QuestionExplanation {
  id             Int      @id @default(autoincrement())
  examId         Int      @map("exam_id")
  questionNumber Int      @map("question_number")
  content        String   @db.Text
  model          String   @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, questionNumber])
  @@map("question_explanations")
}

// Ai Ä‘Ă£ tráº£ phĂ­ xem lá»i giáº£i thĂ­ch cĂ¢u nĂ o: mua rá»“i thĂ¬ xem láº¡i miá»…n phĂ­
model ExplanationPurchase {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  examId         Int      @map("exam_id")
  questionNumber Int      @map("question_number")
  price          Int
  isTrial        Boolean  @default(false) @map("is_trial") // lÆ°á»£t xem thá»­ miá»…n phĂ­ (khĂ´ng trá»« credit)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@index([examId])
  @@map("explanation_purchases")
}

// Má»Ÿ khĂ³a Má»˜T Láº¦N toĂ n bá»™ lá»i giáº£i thĂ­ch cá»§a má»™t Ä‘á» (giĂ¡ gĂ³i, ráº» hÆ¡n mua láº»): xem má»i cĂ¢u miá»…n phĂ­ vá» sau
model ExplanationUnlock {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  examId    Int      @map("exam_id")
  price     Int // credit Ä‘Ă£ tráº£ cho gĂ³i
  questions Int // sá»‘ cĂ¢u Ä‘Æ°á»£c má»Ÿ khĂ³a táº¡i thá»i Ä‘iá»ƒm mua
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([examId])
  @@map("explanation_unlocks")
}

// Má»—i láº§n táº£i bá»™ tĂ i nguyĂªn Ä‘á» thi PE (zip) lĂ  má»™t dĂ²ng: lá»‹ch sá»­ táº£i vĂ  sá»‘ credit Ä‘Ă£ tráº£
model PeDownload {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  threadId  String   @map("thread_id") @db.VarChar(20)
  title     String   @db.VarChar(255)
  price     Int
  files     Int      @default(0) // sá»‘ file trong zip
  sizeBytes Int      @default(0) @map("size_bytes")
  status    String   @default("PENDING") @db.VarChar(10) // PENDING | DONE | FAILED
  error     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, threadId, status]) // tra "Ä‘Ă£ tráº£ tiá»n Ä‘á» nĂ y chÆ°a" má»—i láº§n bĂ¡o giĂ¡/táº£i
  @@map("pe_downloads")
}

enum ReferralRewardType {
  SIGNUP_BONUS // ngÆ°á»i má»›i Ä‘Äƒng kĂ½ qua mĂ£ giá»›i thiá»‡u nháº­n
  REFERRER_BONUS // ngÆ°á»i giá»›i thiá»‡u nháº­n khi cĂ³ ngÆ°á»i Ä‘Äƒng kĂ½ (náº¿u admin báº­t)
  DEPOSIT_COMMISSION // ngÆ°á»i giá»›i thiá»‡u nháº­n hoa há»“ng má»—i láº§n ngÆ°á»i kia náº¡p tiá»n
}

// Sá»• thÆ°á»Ÿng giá»›i thiá»‡u: má»—i dĂ²ng lĂ  má»™t khoáº£n Ä‘Ă£ cá»™ng. depositOrderId duy nháº¥t Ä‘á»ƒ má»™t lá»‡nh náº¡p chá»‰ sinh hoa há»“ng má»™t láº§n.
model ReferralReward {
  id             Int                @id @default(autoincrement())
  referrerId     Int                @map("referrer_id")
  referredId     Int                @map("referred_id")
  type           ReferralRewardType
  amount         Int
  depositOrderId Int?               @unique @map("deposit_order_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  referrer User @relation("RewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("RewardReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([referredId])
  @@map("referral_rewards")
}

// Token xĂ¡c minh email. `email` lĂ  Ä‘á»‹a chá»‰ cáº§n xĂ¡c minh: email hiá»‡n táº¡i (Ä‘Äƒng kĂ½) hoáº·c email má»›i (Ä‘á»•i email).
// Chá»‰ lÆ°u bÄƒm cá»§a token. Email chá»‰ Ä‘Æ°á»£c Ä‘á»•i khi ngÆ°á»i dĂ¹ng báº¥m liĂªn káº¿t gá»­i tá»›i Ä‘á»‹a chá»‰ Má»I.
model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  email     String    @db.VarChar(191)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

// Tri thá»©c cá»§a chatbot há»— trá»£: má»—i má»¥c "## " trong backend/knowledge/*.md lĂ  má»™t Ä‘oáº¡n, kĂ¨m vector embedding Ä‘á»ƒ tĂ¬m Ä‘oáº¡n giá»‘ng cĂ¢u há»i
model KbChunk {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(40)
  title       String   @db.VarChar(200)
  content     String   @db.Text
  contentHash String   @map("content_hash") @db.VarChar(64)
  embedding   Json? // máº£ng sá»‘; null = chÆ°a táº¡o (chÆ°a cĂ³ khoĂ¡ OpenAI), chatbot tĂ¬m báº±ng tá»« khoĂ¡
  model       String?  @db.VarChar(60)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("kb_chunks")
}

// Má»—i cĂ¢u há»i gá»­i chatbot: Ä‘á»ƒ giá»›i háº¡n sá»‘ cĂ¢u má»—i ngĂ y vĂ  Ä‘á»ƒ admin biáº¿t ngÆ°á»i dĂ¹ng hay há»i gĂ¬
model ChatLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  guestId   String?  @map("guest_id") @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  question  String   @db.VarChar(500)
  matched   Boolean  @default(true) // cĂ³ tĂ¬m tháº¥y Ä‘oáº¡n hÆ°á»›ng dáº«n liĂªn quan hay khĂ´ng (false = cĂ¢u há»i há»‡ thá»‘ng chÆ°a cĂ³ tĂ i liá»‡u)
  cached    Boolean  @default(false) // tráº£ lá»i tá»« cache, khĂ´ng gá»i Claude
  inputTokens     Int?    @map("input_tokens") // token cua luot goi Claude (null = tra tu cache hoac loi truoc khi goi)
  outputTokens    Int?    @map("output_tokens")
  cacheReadTokens Int?    @map("cache_read_tokens") // phan prompt doc lai tu cache
  truncated       Boolean @default(false) // cau tra loi cham tran token (da cho viet tiep mot lan ma van chua xong)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("chat_logs")
}

// CĂ¢u tráº£ lá»i hÆ°á»›ng dáº«n chung Ä‘Ă£ cĂ³: cĂ¢u há»i giá»‘ng nghÄ©a thĂ¬ tráº£ láº¡i, khĂ´ng gá»i Claude. Chá»‰ lÆ°u cĂ¢u há»i Ä‘á»©ng riĂªng, khĂ´ng dĂ¹ng dá»¯ liá»‡u tĂ i khoáº£n/giĂ¡.
model ChatAnswerCache {
  id        Int      @id @default(autoincrement())
  viewer    String   @db.VarChar(10) // member | guest: khĂ¡ch vĂ  thĂ nh viĂªn Ä‘Æ°á»£c hÆ°á»›ng dáº«n khĂ¡c nhau (Ä‘Äƒng nháº­p...)
  question  String   @db.VarChar(500)
  embedding Json
  answer    String   @db.Text
  version   String   @db.VarChar(16) // bÄƒm cá»§a tĂ i liá»‡u hÆ°á»›ng dáº«n + prompt; Ä‘á»•i thĂ¬ cache cÅ© háº¿t hiá»‡u lá»±c
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([version])
  @@map("chat_answer_cache")
}

// Lich su mua goi Pro (mua khi con han thi cong don: startsAt = ngay het han cu)
model PlanPurchase {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  plan      String   @db.VarChar(20)
  months    Int
  price     Int
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("plan_purchases")
}

// So cau sai: moi (nguoi dung, de, cau) la mot muc. Lap lai ngat quang kieu Leitner: sai thi ve hop 1 (on lai sau 1 ngay),
// dung thi len hop tiep theo (3, 7, 14, 30 ngay); dung o hop cuoi thi "tot nghiep" (mastered).
model ReviewItem {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  examId         Int       @map("exam_id")
  questionNumber Int       @map("question_number")
  box            Int       @default(1)
  nextReviewAt   DateTime  @map("next_review_at")
  wrongCount     Int       @default(1) @map("wrong_count")
  doubtful       Boolean   @default(false) // dung nhung da danh dau phan van luc lam bai
  mastered       Boolean   @default(false)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@index([userId, mastered, nextReviewAt])
  @@map("review_items")
}

// Ngay co hoc that (theo gio Viet Nam): co nop bai hoac on xong cau trong so cau sai. Dung de tinh chuoi ngay hoc va muc tieu tuan
model StudyDay {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  day      DateTime @db.Date
  attempts Int      @default(0)
  reviews  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("study_days")
}

// Mon hoc (lay tu syllabus FLM bang tools/flm-crawler, nhap bang npm run import:syllabus). Dung de gan chu de cho cau hoi
model Subject {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(200)
  syllabusId String?  @map("syllabus_id") @db.VarChar(20)
  minPassMark Decimal? @map("min_pass_mark") @db.Decimal(3, 1) // MinAvgMarkToPass of the syllabus (null = unknown, assume 5)
  assessments Json?    // syllabus assessment list: [{category, type, weight, minScore}]
  credits     Int?     @db.UnsignedTinyInt // NoCredit of the syllabus (null = unknown)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  chapters SubjectChapter[]

  @@map("subjects")
}

// Mot chuong cua mon (number 0 = nhom "Khac"); topics la mang cac muc noi dung, vd ["1.1. What is an operating system"]
model SubjectChapter {
  id        Int    @id @default(autoincrement())
  subjectId Int    @map("subject_id")
  number    Int
  title     String @db.VarChar(255)
  topics    Json

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, number])
  @@map("subject_chapters")
}

// Danh muc de thi FE tren FuOverflow (chi ten de, nhap tu file JSON do tools/fuo-crawler xuat ra): de Kho de hien du de.
// Anh de chi duoc lay khi nguoi dung bam lay va dong y tru phi.
model FuoThread {
  threadId    String    @id @map("thread_id") @db.VarChar(20)
  subjectCode String    @map("subject_code") @db.VarChar(20)
  title       String    @db.VarChar(255)
  postedAt    DateTime? @map("posted_at")
  replies     Int       @default(0)
  syncedAt    DateTime  @default(now()) @map("synced_at")

  @@index([subjectCode, postedAt])
  @@map("fuo_threads")
}

// Opt-in to sync FAP grades (off by default; turning it off deletes the synced grades)
model UserGradeSetting {
  userId   Int       @id @map("user_id")
  enabled  Boolean   @default(false)
  syncedAt DateTime? @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_grade_settings")
}

// One course of one student as shown on the FAP grade report; components keeps the rows of the mark sheet
model UserGrade {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  courseId    String   @map("course_id") @db.VarChar(40) // FAP course id
  subjectCode String   @map("subject_code") @db.VarChar(20)
  subjectName String   @map("subject_name") @db.VarChar(200)
  termName    String   @map("term_name") @db.VarChar(40)
  classCode   String   @map("class_code") @db.VarChar(60)
  status      String   @db.VarChar(12) // studying | passed | failed | unknown
  average     Decimal? @db.Decimal(4, 2)
  components  Json
  syncedAt    DateTime @default(now()) @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, subjectCode])
  @@map("user_grades")
}

// One exam sitting from the student's FAP exam schedule (replaced as a whole on every sync, deleted with the grades)
model UserExamSlot {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  examDate    DateTime  @map("exam_date") @db.Date
  startTime   String    @map("start_time") @db.VarChar(5)
  endTime     String    @map("end_time") @db.VarChar(5)
  room        String    @db.VarChar(20)
  subjectCode String    @map("subject_code") @db.VarChar(20)
  subjectName String    @map("subject_name") @db.VarChar(200)
  format      String    @db.VarChar(30) // PRACTICAL_EXAM | Multiple_choices | ...
  kind        String    @db.VarChar(12) // FE | PE | 2NDFE | other (as shown on FAP)
  resultDate  DateTime? @map("result_date") @db.Date
  note        String    @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examDate])
  @@map("user_exam_slots")
}

// Vuot link (Link4M) de nhan luot giai thich AI mien phi. Moi yeu cau co ma dung mot lan gan voi tai khoan.
model LinkRewardRequest {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64) // SHA-256 cua ma trong link dich; ma goc khong luu
  shortUrl  String    @map("short_url") @db.VarChar(255)
  status    String    @default("PENDING") @db.VarChar(10) // PENDING | CLAIMED
  provider  String    @default("link4m") @db.VarChar(20) // link4m | shrinkme
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  claimedAt DateTime? @map("claimed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns FreeExplainTurn[]

  @@index([userId, createdAt])
  @@map("link_reward_requests")
}

// Mot luot giai thich mien phi (het han sau so ngay admin dat). Dung theo thu tu sap het han truoc.
model FreeExplainTurn {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  requestId          Int?      @map("request_id")
  grantedAt          DateTime  @default(now()) @map("granted_at")
  expiresAt          DateTime  @map("expires_at")
  usedAt             DateTime? @map("used_at")
  usedExamId         Int?      @map("used_exam_id")
  usedQuestionNumber Int?      @map("used_question_number")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  request LinkRewardRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, usedAt, expiresAt])
  @@index([requestId])
  @@map("free_explain_turns")
}

// Van de voi du lieu syllabus cua mon (vi du khong co ten chuong), admin xem va xu ly. Moi (mon, loai) mot dong, hits dem so lan gap.
model SubjectIssue {
  id          Int      @id @default(autoincrement())
  subjectCode String   @map("subject_code") @db.VarChar(20)
  kind        String   @db.VarChar(30) // NO_CHAPTER_NAMES
  hits        Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([subjectCode, kind])
  @@map("subject_issues")
}

// Noi dung Syllabus cua mon (crawl tu FLM) chia thanh cac doan de tim kiem theo nghia. embedding: float32 little-endian (768 so); null = chua tao.
model SubjectChunk {
  id          Int      @id @default(autoincrement())
  subjectCode String   @map("subject_code") @db.VarChar(20)
  kind        String   @db.VarChar(20) // overview | tasks | materials | clo | chapters | sessions | cq | assessment
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  contentHash String   @map("content_hash") @db.Char(64)
  embedding   Bytes?   @db.MediumBlob
  model       String?  @db.VarChar(60)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subjectCode])
  @@map("subject_chunks")
}

// Upgrade/top-up prompt events (shown, click, dismiss) to measure prompts and A/B tests. First-party, no third party.
model PromptEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  surface   String   @db.VarChar(40)
  event     String   @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([surface, event, createdAt])
  @@index([userId])
  @@map("prompt_events")
}

// Pro ticket: paid now, activated later by the user. activatedAt null = still unused.
// An unused ticket can no longer be activated after expiresAt (the buyer is told the date when buying).
model ProTicket {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  plan        String    @db.VarChar(20) // PRO | SPRINT
  price       Int
  expiresAt   DateTime  @map("expires_at") // last moment the ticket can be activated
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activatedAt])
  @@map("pro_tickets")
}
