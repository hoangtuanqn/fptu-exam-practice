generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  fullName  String     @map("full_name")
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  balance   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  walletTransactions WalletTransaction[]
  depositOrders      DepositOrder[]
  userExams          UserExam[]
  attempts           ExamAttempt[]

  @@map("users")
}

enum DepositStatus {
  PENDING
  PAID
  EXPIRED
}

// Lệnh nạp tiền: người dùng chuyển khoản kèm `code` trong nội dung để hệ thống đối soát
model DepositOrder {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  code      String        @unique @db.VarChar(30)
  amount    Int
  status    DepositStatus @default(PENDING)
  expiresAt DateTime      @map("expires_at")
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id])
  bankTransaction BankTransaction?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("deposit_orders")
}

enum BankTxStatus {
  MATCHED // khớp lệnh nạp và đã cộng tiền
  UNMATCHED // tiền vào nhưng không khớp lệnh nào (admin xử lý tay)
}

// Giao dịch ngân hàng lấy từ SePay. `sepayId` unique để cùng một giao dịch không bao giờ cộng tiền hai lần
model BankTransaction {
  id             Int          @id @default(autoincrement())
  sepayId        String       @unique @map("sepay_id") @db.VarChar(40)
  gateway        String?
  accountNumber  String?      @map("account_number")
  content        String       @db.Text
  amountIn       Int          @map("amount_in")
  referenceCode  String?      @map("reference_code")
  transactionAt  DateTime     @map("transaction_at")
  status         BankTxStatus
  depositOrderId Int?         @unique @map("deposit_order_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  depositOrder DepositOrder? @relation(fields: [depositOrderId], references: [id])

  @@index([status, createdAt])
  @@map("bank_transactions")
}

// Cấu hình dạng key-value, admin sửa được trên panel (SePay, cron, ...)
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum TransactionType {
  DEPOSIT
  ADMIN_ADJUST
  CRAWL_CHARGE // trừ phí lấy đề từ FuOverflow
  CRAWL_REFUND // hoàn phí khi lấy đề thất bại
}

// Sổ cái ví: mỗi lần số dư đổi là một dòng (amount âm = trừ tiền)
model WalletTransaction {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  note         String?
  createdAt    DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// Đề thi lấy từ FuOverflow. `threadId` là chữ ký của đề: nhập lại cùng thread (dù link khác) không tạo bản mới
model Exam {
  id             Int       @id @default(autoincrement())
  threadId       String    @unique @map("thread_id") @db.VarChar(20)
  title          String    @db.VarChar(255)
  sourceUrl      String    @map("source_url") @db.VarChar(500)
  author         String?   @db.VarChar(100)
  postedAt       DateTime? @map("posted_at")
  totalQuestions Int       @map("total_questions")
  createdById    Int?      @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  questions ExamQuestion[]
  crawlJobs CrawlJob[]
  userExams UserExam[]
  attempts  ExamAttempt[]

  @@map("exams")
}

// Mỗi ảnh là một câu hỏi. `answer` tạm là "A" cho đến khi có logic xác định đáp án đúng
model ExamQuestion {
  id          Int     @id @default(autoincrement())
  examId      Int     @map("exam_id")
  number      Int
  name        String  @db.VarChar(100)
  imagePath   String  @map("image_path") @db.VarChar(255)
  sourceImage String  @map("source_image") @db.VarChar(500)
  mediaUrl    String? @map("media_url") @db.VarChar(500)
  answer      String  @default("A") @db.VarChar(20)

  exam     Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  comments ExamComment[]

  @@unique([examId, number])
  @@map("exam_questions")
}

// Bình luận dưới ảnh trên FuOverflow (thường là đáp án do người dùng đề xuất)
model ExamComment {
  id          Int       @id @default(autoincrement())
  questionId  Int       @map("question_id")
  externalId  String    @map("external_id") @db.VarChar(30)
  author      String    @db.VarChar(100)
  authorScore String?   @map("author_score") @db.VarChar(20)
  postedAt    DateTime? @map("posted_at")
  text        String    @db.Text
  url         String    @db.VarChar(500)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("exam_comments")
}

enum CrawlJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Một lượt nhập đề: tạo ở trạng thái QUEUED, worker nền nhận và cập nhật `stage` theo từng bước
model CrawlJob {
  id            Int            @id @default(autoincrement())
  threadId      String         @map("thread_id") @db.VarChar(20)
  userId        Int?           @map("user_id") // khách chưa đăng nhập thì null, dùng guestId
  guestId       String?        @map("guest_id") @db.VarChar(64)
  status        CrawlJobStatus @default(QUEUED)
  stage         String?        @db.VarChar(120)
  error         String?        @db.Text
  examId        Int?           @map("exam_id")
  chargedAmount Int            @default(0) @map("charged_amount") // phí đã trừ, để hoàn đúng số tiền nếu job lỗi
  createdAt     DateTime       @default(now()) @map("created_at")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")

  exam Exam? @relation(fields: [examId], references: [id])

  @@index([threadId, status])
  @@index([guestId, status])
  @@index([status, createdAt])
  @@map("crawl_jobs")
}

// Thư viện đề của từng người: nhập link xong là đề nằm trong đây (đề dùng chung, chỉ lưu liên kết)
model UserExam {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  guestId   String?  @map("guest_id") @db.VarChar(64) // khách chưa đăng nhập: kho riêng theo trình duyệt, nhận về tài khoản khi đăng ký
  examId    Int      @map("exam_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@unique([guestId, examId])
  @@index([guestId, createdAt])
  @@index([userId, createdAt])
  @@map("user_exams")
}

enum AttemptMode {
  PRACTICE
  EXAM
}

// Một lần nộp bài. `details` là ảnh chụp từng câu (đã chọn, đáp án đúng lúc chấm) nên xem lại vẫn đúng
// dù sau này đáp án của đề được sửa
model ExamAttempt {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  examId      Int         @map("exam_id")
  mode        AttemptMode
  score       Float
  totalGraded Int         @map("total_graded")
  correct     Int
  wrong       Int
  skipped     Int
  durationSec Int         @map("duration_sec")
  details     Json
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, examId])
  @@map("exam_attempts")
}
