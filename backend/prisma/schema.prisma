// Noi dung Syllabus cua mon (crawl tu FLM) chia thanh cac doan de tim kiem theo nghia. embedding: float32 little-endian (768 so); null = chua tao.
model SubjectChunk {
  id          Int      @id @default(autoincrement())
  subjectCode String   @map("subject_code") @db.VarChar(20)
  kind        String   @db.VarChar(20) // overview | tasks | materials | clo | chapters | sessions | cq | assessment
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  contentHash String   @map("content_hash") @db.Char(64)
  embedding   Bytes?   @db.MediumBlob
  model       String?  @db.VarChar(60)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subjectCode])
  @@map("subject_chunks")
}

// Upgrade/top-up prompt events (shown, click, dismiss) to measure prompts and A/B tests. First-party, no third party.
model PromptEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  surface   String   @db.VarChar(40)
  event     String   @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([surface, event, createdAt])
  @@index([userId])
  @@map("prompt_events")
}

// Pro ticket: paid now, activated later by the user. activatedAt null = still unused.
// An unused ticket can no longer be activated after expiresAt (the buyer is told the date when buying).
model ProTicket {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  plan        String    @db.VarChar(20) // PRO | SPRINT
  price       Int
  expiresAt   DateTime  @map("expires_at") // last moment the ticket can be activated
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activatedAt])
  @@map("pro_tickets")
}

// Vector of a question per embedding model (float32 little-endian bytes). Model image-fingerprint-v1 is derived from imageHash.
model QuestionEmbedding {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  modelName  String   @map("model_name") @db.VarChar(64)
  dimensions Int
  embedding  Bytes    @db.MediumBlob
  createdAt  DateTime @default(now()) @map("created_at")

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, modelName])
  @@index([modelName])
  @@map("question_embeddings")
}

// Near-identical questions across exams of one subject. Rebuilt as a whole per subject by npm run groups:build
model QuestionGroup {
  id          Int      @id @default(autoincrement())
  subjectId   Int      @map("subject_id")
  modelName   String   @map("model_name") @db.VarChar(64)
  threshold   Float
  memberCount Int      @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  subject Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  members QuestionGroupMember[]
  stats   QuestionGroupStat?

  @@index([subjectId])
  @@map("question_groups")
}

// subjectId is copied from the group so a question belongs to at most one group per subject
model QuestionGroupMember {
  id         Int @id @default(autoincrement())
  groupId    Int @map("group_id")
  subjectId  Int @map("subject_id")
  questionId Int @map("question_id")

  group    QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject  Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  question ExamQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([subjectId, questionId])
  @@index([groupId])
  @@index([questionId])
  @@map("question_group_members")
}

// Past exam frequency of a chapter (ExamQuestion.topic) in a subject. Statistics only, refreshed by npm run stats:refresh
model ChapterStat {
  id                  Int       @id @default(autoincrement())
  subjectId           Int       @map("subject_id")
  chapter             String    @db.VarChar(255)
  questionCount       Int       @map("question_count")
  examsWithChapter    Int       @map("exams_with_chapter")
  totalExams          Int       @map("total_exams")
  avgQuestionsPerExam Float     @map("avg_questions_per_exam") // question_count / total_exams
  recencyScore        Float     @map("recency_score") // 0..1, exams weighted by 0.5^(age/half-life)
  confidence          String    @db.VarChar(10) // low | medium | high, from total_exams
  lastSeenAt          DateTime? @map("last_seen_at")
  computedAt          DateTime  @map("computed_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, chapter])
  @@map("chapter_stats")
}

// Past exam frequency of a question group. last_seen_exam_id and representative_question_id have no FK (derived, rebuilt on refresh)
model QuestionGroupStat {
  groupId                  Int       @id @map("group_id")
  subjectId                Int       @map("subject_id")
  chapter                  String?   @db.VarChar(255)
  examsWithGroup           Int       @map("exams_with_group")
  totalExams               Int       @map("total_exams")
  lastSeenExamId           Int?      @map("last_seen_exam_id")
  lastSeenAt               DateTime? @map("last_seen_at")
  representativeQuestionId Int?      @map("representative_question_id") // member in the newest exam
  recencyScore             Float     @map("recency_score")
  confidence               String    @db.VarChar(10)
  computedAt               DateTime  @map("computed_at")

  group   QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, examsWithGroup, recencyScore], map: "question_group_stats_subject_rank_idx")
  @@map("question_group_stats")
}

// FSRS card (ts-fsrs) of a user for one question. Separate from the Leitner ReviewItem. state: 0 New, 1 Learning, 2 Review, 3 Relearning
model UserQuestionCard {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  questionId    Int       @map("question_id")
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int       @map("elapsed_days")
  scheduledDays Int       @map("scheduled_days")
  learningSteps Int       @map("learning_steps")
  reps          Int
  lapses        Int
  state         Int       @db.TinyInt
  lastReview    DateTime? @map("last_review")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, due])
  @@index([questionId])
  @@map("user_question_cards")
}

// One FSRS review (the log returned by ts-fsrs). rating: 1 Again, 2 Hard, 3 Good, 4 Easy
model UserReviewLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  questionId      Int      @map("question_id")
  rating          Int      @db.TinyInt
  state           Int      @db.TinyInt
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int      @map("elapsed_days")
  lastElapsedDays Int      @map("last_elapsed_days")
  scheduledDays   Int      @map("scheduled_days")
  learningSteps   Int      @map("learning_steps")
  reviewedAt      DateTime @map("reviewed_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([questionId])
  @@map("user_review_logs")
}

// Last successful nightly similarity run of a subject (jobs/similarity.cron.ts). exam_signature = count, id sum and newest
// created/refreshed time of the usable exams it saw; hash_cursor = last question id it tried to fingerprint (failures behind it are not retried until the exams change)
model SimilarityJobRun {
  subjectId     Int      @id @map("subject_id")
  examSignature String   @map("exam_signature") @db.VarChar(100)
  hashCursor    Int      @default(0) @map("hash_cursor")
  finishedAt    DateTime @map("finished_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("similarity_job_runs")
}

// Tokens used by one AI call made for a user (input + output + cache creation as reported by the provider).
// Generic ledger: feature = which feature spent them (only "material" for now). Used for rolling-window limits.
// input_tokens includes cache creation tokens; total_tokens = input_tokens + output_tokens.
model AiTokenUsage {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  feature      String   @db.VarChar(30)
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  totalTokens  Int      @map("total_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@map("ai_token_usage")
}

// AI chat about an explained question: messages sent per user per Vietnam calendar day (day = DATE, see utils/time vnDate).
// Incremented atomically before the AI call, decremented when the call fails.
model ExplainChatUsage {
  userId Int      @map("user_id")
  day    DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("explain_chat_usage")
}

// Đánh giá 👍/👎 của người dùng cho lời giải thích AI của một câu: mỗi người một đánh giá cho mỗi câu, đổi ý thì ghi đè.
// reason (WRONG | UNCLEAR | WRONG_SUBJECT | OTHER) và comment chỉ có khi không hữu ích; dùng để cải thiện prompt.
model ExplanationFeedback {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  examId         Int      @map("exam_id")
  questionNumber Int      @map("question_number")
  helpful        Boolean
  reason         String?  @db.VarChar(20)
  comment        String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, questionNumber])
  @@index([helpful, updatedAt])
  @@index([examId, questionNumber])
  @@map("explanation_feedback")
}

enum MaterialStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// A slide PDF uploaded by a user for analysis. Private to the uploader. The PDF itself is deleted when processing ends;
// the row and its pages/chapters are deleted by the daily cleanup after expires_at. subject_id has no FK on purpose
// (subjects are never deleted in practice; a missing subject just hides the stats).
model MaterialUpload {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  subjectId     Int            @map("subject_id")
  title         String         @db.VarChar(200)
  fileHash      String         @map("file_hash") @db.Char(64) // sha256 hex of the PDF, dedupe within the same user only
  pageCount     Int            @map("page_count")
  status        MaterialStatus @default(QUEUED)
  error         String?        @db.VarChar(500) // short Vietnamese message shown to the user
  progressDone  Int            @default(0) @map("progress_done")
  progressTotal Int            @default(0) @map("progress_total")
  createdAt     DateTime       @default(now()) @map("created_at")
  finishedAt    DateTime?      @map("finished_at")
  expiresAt     DateTime       @map("expires_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages    MaterialPage[]
  chapters MaterialChapter[]

  @@index([userId, createdAt])
  @@index([userId, fileHash])
  @@index([status])
  @@index([expiresAt])
  @@map("material_uploads")
}

// One page of an uploaded PDF. kind = text | figure | scanned. figure = vision result (null until described).
// assigned = chapter assignment done (chapter_number null + assigned = page matched no chapter).
model MaterialPage {
  uploadId      Int     @map("upload_id")
  pageNo        Int     @map("page_no")
  kind          String  @db.VarChar(10)
  text          String  @db.Text
  figure        Json?
  assigned      Boolean @default(false)
  chapterNumber Int?    @map("chapter_number")

  upload MaterialUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, pageNo])
  @@map("material_pages")
}

// Summary of one chapter built only from the pages assigned to it. key_points = [{text, pages[]}]
model MaterialChapter {
  uploadId      Int    @map("upload_id")
  chapterNumber Int    @map("chapter_number")
  summary       String @db.Text
  keyPoints     Json   @map("key_points")

  upload MaterialUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, chapterNumber])
  @@map("material_chapters")
}

// Thu marketing tu dong da gui (win-back, moi Pro, nhac het han Pro). Ghi TRUOC khi gui: unique chan gui trung khi cron chay lai.
// step: winback = 1..3; chien dich lap lai (pro_upsell, pro_expiry) = cycle * 10 + buoc, cycle = so ngay UTC tu 1970 (ngay gui / ngay het han Pro)
model EmailCampaignLog {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  campaign   String    @db.VarChar(40) // campaign key or broadcast:<id>
  step       Int
  sentAt     DateTime  @default(now()) @map("sent_at")
  target     String?   @db.VarChar(120) // internal path the mail button leads to (click redirect never reads it from the URL)
  clickedAt  DateTime? @map("clicked_at") // first click on the button, scanner hits right after sending ignored
  returnedAt DateTime? @map("returned_at") // first activity of the user within 7 days after the mail

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaign, step])
  @@index([userId, sentAt]) // gioi han 1 thu / 7 ngay moi nguoi
  @@index([campaign, step]) // admin dem so thu da gui moi buoc
  @@index([campaign, sentAt]) // so thu hom nay, pheu 30 ngay theo chien dich
  @@map("email_campaign_logs")
}

enum BroadcastStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

// Thu gui thu cong (admin soan, chu de "news"). Gui qua dung luot chay marketing hang ngay, log campaign = broadcast:<id>, step 1.
// Nguoi nhan tinh lai moi ngay theo segment (khong chup san).
model MarketingBroadcast {
  id          Int             @id @default(autoincrement())
  subject     String          @db.VarChar(120)
  body        String          @db.Text // plain text, escaped when rendered
  ctaLabel    String          @map("cta_label") @db.VarChar(40)
  ctaPath     String          @map("cta_path") @db.VarChar(120) // internal path only
  segment     String          @db.VarChar(20) // all | pro | free | inactive | exam_soon
  segmentDays Int?            @map("segment_days") // inactive: days without activity (7..180)
  status      BroadcastStatus @default(DRAFT)
  sendingLock Boolean?        @unique @map("sending_lock") // true only while SENDING: at most one SENDING broadcast
  createdById Int             @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("marketing_broadcasts")
}
