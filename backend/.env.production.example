# Môi trường PRODUCTION (VPS). Sao chép thành backend/.env trên máy chủ rồi điền các giá trị còn trống.
# Script deploy/deploy.sh tự tạo file này lần đầu và điền sẵn DATABASE_URL, JWT_SECRET.
NODE_ENV=production
PORT=8000

# Web chạy ở fepass.top, API ở api.fepass.top
CLIENT_URL=https://fepass.top
API_URL=https://api.fepass.top
TRUST_PROXY=1

# Tự điền bởi deploy.sh
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Tài khoản admin đầu tiên (npm run seed). ĐỔI mật khẩu này, và đổi lại trong trang cá nhân sau khi đăng nhập
ADMIN_EMAIL=admin@fepass.top
ADMIN_PASSWORD=do-deploy-sh-tu-sinh

# SMTP (Lark: smtp.larksuite.com, cổng 465)
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_EXPIRES_MIN=30

# Claude (có thể nhập ở trang Quản trị thay cho biến này)
ANTHROPIC_API_KEY=

# Google OAuth Web client ID. Thêm https://fepass.top vào Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# GitHub OAuth App. Authorization callback URL = https://fepass.top/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

STORAGE_DIR=/home/fepass/storage
