NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173

# MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/exam_practice"

# Chuỗi bí mật ký JWT (>= 32 ký tự)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu
JWT_EXPIRES_IN=7d

# Tài khoản admin đầu tiên (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Thư mục lưu ảnh đề đã crawl (tương đối so với nơi chạy server)
STORAGE_DIR=storage
