NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173
# Địa chỉ công khai của API khi web ở domain khác (để ảnh đề trỏ đúng). Dev để trống.
API_URL=
# Số lớp reverse proxy (Nginx) phía trước. Dev để 0, production sau Nginx để 1.
TRUST_PROXY=0

# MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/exam_practice"

# Chuỗi bí mật ký JWT (>= 32 ký tự)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu
JWT_EXPIRES_IN=7d

# Tài khoản admin đầu tiên (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# SMTP gửi email quên mật khẩu (Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="MST Software <ban@example.com>"
PASSWORD_RESET_EXPIRES_MIN=30

# Claude (Anthropic) giải đáp án khi lấy đề (có thể nhập khóa ở Quản trị thay cho biến này)
ANTHROPIC_API_KEY=
# AI_PROMPT_FILE=assets/prompts/exam-solver.system.md

# Thư mục lưu ảnh đề đã crawl (tương đối so với nơi chạy server)
STORAGE_DIR=storage

# Đăng nhập Google: OAuth client ID loại "Web application" (Google Cloud Console > APIs & Services > Credentials).
# Thêm Authorized JavaScript origins = địa chỉ web (ví dụ http://localhost:5173). Bỏ trống thì ẩn nút đăng nhập Google.
GOOGLE_CLIENT_ID=
