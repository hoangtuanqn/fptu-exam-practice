# Sao chép thành .env (hoặc .env.local) rồi sửa. Để trống thì dùng giá trị mặc định trong brand.config.ts.
# Đổi xong cần chạy lại `npm run dev` / build lại.

VITE_COMPANY_NAME="MST Software"
VITE_APP_NAME="Luyện thi FE FPTU"
VITE_APP_TAGLINE="MMO Solution"
VITE_APP_SLOGAN="Hành trình đi đến điểm 10."
VITE_APP_DESCRIPTION=""

# Địa chỉ website khi đã deploy, ví dụ https://luyende.example.com (để ảnh bìa hiện đúng khi chia sẻ link)
VITE_SITE_URL=""
# Trang chủ công ty (tuỳ chọn). Để trống thì footer trỏ về Facebook
VITE_COMPANY_URL=""
VITE_FACEBOOK_URL="https://facebook.com/mstsoftware.vn"
VITE_FOUNDER="Phạm Hoàng Tuấn"
VITE_CO_FOUNDERS="Vũ Việt Quang, Mai Trung Hậu"
# Đối tác cung cấp kho đề (logo: public/brand/fuoverflow.webp)
VITE_PARTNER_NAME="FuOverflow"
VITE_PARTNER_URL="https://fuoverflow.com"
VITE_THEME_COLOR="#0b1730"
