{
  "manifest_version": 3,
  "name": "FePass – Làm đề FE trên fepass.top",
  "short_name": "FePass",
  "version": "1.4.0",
  "description": "Thêm nút “Làm đề thi trên fepass.top” cạnh các bài có nhãn Đề Thi FE trên FuOverflow. Bấm là mở thẳng hộp xác nhận lấy đề trên fepass.top. Nếu bạn bật, còn đồng bộ điểm FAP để gợi ý điểm cần đạt cho từng môn.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FePass",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.fepass.top/*", "https://fepass.top/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fuoverflow.com/*", "https://*.fuoverflow.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fap.fpt.edu.vn/*"],
      "js": ["shared.js", "fap-parser.js", "fap.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fepass.top/*", "https://www.fepass.top/*", "http://localhost/*"],
      "js": ["shared.js", "site.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png", "fonts/*.woff2"],
      "matches": ["https://fuoverflow.com/*", "https://*.fuoverflow.com/*"]
    }
  ]
}
